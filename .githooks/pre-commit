#!/bin/sh
set -e

rootdir=$(git rev-parse --show-toplevel)
cd "$rootdir"

cleanup() {
    rm -f "$rootdir"/*.shell-extension.zip "$rootdir"/*.zip "$rootdir"/schemas/gschemas.compiled
}
trap cleanup EXIT

echo "==> Running local CI checks (same as .github/workflows/test.yml)..."

# 1. Run ESLint
echo "--> [1/3] Running ESLint..."
./tools/run-eslint.sh

# 2. Compile schema & validate with shexli (strict mode)
echo "--> [2/3] Validating schema & package with shexli..."
glib-compile-schemas schemas/
./tools/run-shexli.sh --strict

# 3. Run GJS Unit Tests
echo "--> [3/3] Running GJS unit tests..."
gjs -m test/config_test.js

echo "==> All checks passed!"
