{
  "metrics": [
    {
      "id": "cpu_usage",
      "label": "CPU",
      "promql": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode='idle'}[5m])) * 100)",
      "unit": "%",
      "show_in_topbar": true,
      "icon": "cpu-symbolic"
    },
    {
      "id": "ram_free",
      "label": "RAM Free",
      "promql": "node_memory_MemFree_bytes / 1024 / 1024 / 1024",
      "unit": "GB",
      "show_in_topbar": false,
      "icon": "memory-symbolic"
    }
  ]
}